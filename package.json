{
  "name": "forkline",
  "version": "0.0.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "Personal OpenAI-compatible bridge over the Claude Agent SDK",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:live": "node --env-file-if-exists=secrets/forkline.env node_modules/vitest/vitest.mjs run --config vitest.live.config.ts",
    "regression": "tsx --env-file-if-exists=secrets/forkline.env tools/regression/run.ts",
    "dev": "tsx --env-file-if-exists=secrets/forkline.env src/main.ts",
    "start": "node --env-file-if-exists=secrets/forkline.env dist/main.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.318",
    "fastify": "5.12.8",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}

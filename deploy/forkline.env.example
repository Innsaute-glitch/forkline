# Forkline secrets. Installed by deploy/install.sh as /etc/forkline/forkline.env, owner root, mode 0600.
# systemd format: NAME=value, one per line, no quotes, no "export", no spaces around "=".
# Never commit a filled-in copy. Never paste either value into a chat, ticket or log.

# Key that Lumiverse sends as "Authorization: Bearer <key>". At least 16 characters.
# install.sh fills this in with a random 64-character value the first time.
FORKLINE_API_KEY=CHANGE_ME_install_sh_replaces_this_line

# Output of "claude setup-token" (a long string starting sk-ant-oat). See RUNBOOK.md step 5.
FORKLINE_CLAUDE_TOKEN=
